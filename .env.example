APP_NAME="Colegio SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hosts del panel central, separados por coma y sin esquema ni puerto.
# En produccion, por ejemplo: CENTRAL_DOMAINS=app.colegios.example.com
CENTRAL_DOMAINS=127.0.0.1,localhost
# Sufijo publico de tenants: <slug>.<TENANT_BASE_DOMAIN>. Debe formar parte
# de CENTRAL_DOMAINS; si se omite, se deriva de esa lista.
TENANT_BASE_DOMAIN=localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# BD CENTRAL de la plataforma (PostgreSQL). Cada colegio (tenant) recibe una
# BD `tenant_<slug>_<id-corto>` creada automaticamente (RN-AI-001).
# Copia este archivo a .env y ajusta DB_USERNAME/DB_PASSWORD a tu PostgreSQL local.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=colegio_saas_central
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seguridad de sesiones y autenticacion
SANCTUM_TOKEN_EXPIRATION_MINUTES=480
LOGIN_ATTEMPTS_PER_MINUTE=5
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=30
MFA_REQUIRED_FOR_PLATFORM=true
MFA_REQUIRED_TENANT_ROLES=rector,coord_academico,coord_convivencia,coord_combinado,secretaria
IMPERSONATION_TTL_MINUTES=120
IMPERSONATION_REASON_REQUIRED=true
OAUTH_STATE_TTL_MINUTES=15
OAUTH_CACHE_STORE=central_database
FRONTEND_URL=http://localhost:5173

# Pipeline de almacenamiento por tenant
STORAGE_TENANT_DISK=tenant
STORAGE_MAX_FILE_MB=25
STORAGE_SIGNED_URL_MINUTES=15
# Produccion: `clamav`; `null` solo para desarrollo/tests controlados.
STORAGE_SCANNER=null
CLAMAV_ENDPOINT=tcp://127.0.0.1:3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=3
CLAMAV_READ_TIMEOUT_SECONDS=30
CLAMAV_CHUNK_BYTES=65536

# Retencion y purga automatica de borrados logicos
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_PURGE_TIME=02:30
