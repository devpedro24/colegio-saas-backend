# Baseline only. Merge with .env.example, supply secrets privately, do not commit .env.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://colegio.example
FRONTEND_URL=https://colegio.example
TENANCY_CENTRAL_DOMAINS=colegio.example
APP_KEY=
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
PERFORMANCE_LOG_ENABLED=true
PERFORMANCE_SLOW_MS=750
PERFORMANCE_SAMPLE_RATE=0.01

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=colegio_saas_central
DB_USERNAME=colegio_app
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REALTIME_QUEUE=realtime
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
REDIS_CLIENT=phpredis
# Durable instance for queue and sessions: noeviction, AOF, private port.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Separate disposable cache instance: allkeys-lru. Never evict queued jobs.
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Backend publisher uses private HTTP; browser VITE settings use public WSS.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=colegio.example,*.colegio.example
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
REVERB_APP_RATE_LIMITING_ENABLED=true

STORAGE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Configure real mail delivery separately; do not log reset links in production.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
